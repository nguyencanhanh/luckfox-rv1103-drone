	(lib_symbols)
	(text "LFX FC R2  -  Luckfox Pico Mini B (RV1103) flight controller + LTE / GNSS, one 50 x 50 mm board"
		(at 20 24 0)
		(effects (font (size 3.2 3.2) (bold yes)) (justify left bottom))
		(uuid "a6ecdec1-beca-1201-5f2f-ad24dde18471")
	)
	(text "Rails : VBAT 2S-6S (ESC JST-SH 8) -> TPS54360 buck -> +5V -> LM66100 ideal diode -> VSYS (Luckfox VBUS)"
		(at 20 32 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "14ec011f-68a9-1a0f-c234-f168431ba729")
	)
	(text "        VSYS -> TLV75533 -> +3V3S (IMU + barometer only)    +1V8 from the module, ADC clamps only"
		(at 20 37 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "c851b7e5-05d0-7ed0-7f6a-5e7b9359d619")
	)
	(text "SPI0  : ICM-42688-P (CS0, pin 6) + BMP390 (CS1, pin 14), MCU-owned per docs/architecture.html"
		(at 20 42 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "b212919f-8ce1-9daf-a83b-eb0092077950")
	)
	(text "ESC   : PWM8-11_M1 on module pins 10, 11, 16, 17 -> 47R -> S/G pads in the corners, four separate ESCs"
		(at 20 47 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "62d800a0-6333-ef6d-b763-1975cba0c7f2")
	)
	(text "UART  : UART2 RC receiver (pins 4/5) on JST-SH, ESD by TPD4E05U06"
		(at 20 52 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "bc622135-67df-8a98-bd14-e3399f295706")
	)
	(text "LTE   : Lierda NT26-KCN E (bottom) on UART3 (pins 12/13) via SN74LVC1T45, RESET pin 18, BOOT pin 20;"
		(at 20 57 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "a05780bb-5ce0-72d1-113b-6000d317b43e")
	)
	(text "        nano-SIM (top), U.FL LTE + GNSS (bottom front corners), +5V -> TLV62569 -> +3V8, buzzer on its AGPIO5"
		(at 20 62 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "3922cc9d-4364-79e6-3025-939f89e6483f")
	)
