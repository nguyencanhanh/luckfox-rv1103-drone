	(lib_symbols)
	(text "LFX FC R1  -  Luckfox Pico Mini B (RV1103) flight controller carrier, 36 x 36 mm, 30.5 mm stack"
		(at 20 24 0)
		(effects (font (size 3.2 3.2) (bold yes)) (justify left bottom))
		(uuid "6a80afde-ef6a-a27b-5baf-eec4b52c2cab")
	)
	(text "Rails : VBAT 2S-6S (ESC JST-SH 8) -> TPS54360 buck -> +5V -> LM66100 ideal diode -> VSYS (Luckfox VBUS)"
		(at 20 32 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "d778eec5-e2b9-b96a-deca-b5a71efae7ad")
	)
	(text "        VSYS -> TLV75533 -> +3V3S (IMU + barometer only)    +1V8 from the module, ADC clamps only"
		(at 20 37 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "0f0bc908-c007-da1d-230f-2c5eb599e02e")
	)
	(text "SPI0  : ICM-42688-P (CS0, pin 6) + BMP390 (CS1, pin 14), MCU-owned per docs/architecture.html"
		(at 20 42 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "830b04ec-3392-59a0-cd88-d74e086d71c7")
	)
	(text "ESC   : PWM8-11_M1 on module pins 10, 11, 16, 17 -> 47R -> JST-SH 8 pins 5-8"
		(at 20 47 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "779294a8-607d-1b7f-caae-77c631b502c0")
	)
	(text "UART  : UART2 debug (pins 4/5) and UART3 GPS (pins 12/13) on JST-SH, ESD by TPD4E05U06"
		(at 20 52 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "bdf9d6c5-2fa2-5a92-97db-c33fc3572edc")
	)
